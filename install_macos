#!/usr/bin/env bash

# Назначение:
#   Запуск установки dotfiles для macos из любого рабочего каталога.
#
# Использование:
#   ./install_macos [параметры Dotbot...], например --only link.
#
# Окружение:
#   Все параметры без изменений передаются каждому этапу scripts/install_all. HOME и
#   PATH используются общим установщиком; специальных параметров нет.
#   Функций нет.
#
# Результат:
#   Общий установщик выполняет зависимости, terminal, Vim, VSCode и Zed; сообщает
#   этапы в stderr и возвращает 0 при успехе, иначе код ошибки. exec сохраняет
#   код выхода, не создавая отдельного шага после установки.

set -euo pipefail

# --- Передача управления: найти репозиторий относительно самого скрипта ---
exec bash "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/scripts/install_all" macos "$@"
