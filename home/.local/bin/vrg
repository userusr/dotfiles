#!/usr/bin/env bash

# Назначение:
#   Интерактивно искать текст в текущем каталоге
#   и открывать совпадения в VS Code.
#
# Использование:
#   vrg '<шаблон ripgrep>' (ровно один аргумент, регулярное выражение).
#
# Параметры:
#   $1 — шаблон поиска; пробелы/метасимволы shell заключайте в кавычки.
#
# Окружение:
#   PATH должен содержать rg, fzf, bat, code; запускать в интерактивном
#   терминале.
#
# Функции:
#   log выводит диагностику в stderr; stdout от rg передаётся только в fzf.
#
# Результат:
#   Список максимум из двух совпавших строк на файл; bat показывает контекст,
#   Enter открывает выбранную строку в новом окне VS Code. Esc/Ctrl-C закрывает
#   список.
#
# Код выхода:
#   0 — выбор; 1 — аргументы/зависимости/нет выбора; 130 — отмена; при ошибке rg
#   возвращается его код, иначе код fzf. Файлы не изменяются.

# --- Диагностика: один аргумент — сообщение, не вмешивается в поток совпадений ---
log() { printf '[vrg] %s\n' "$*" >&2; }

# --- Проверка: без шаблона или необходимых команд интерактивный поиск невозможен ---
if (( $# != 1 )); then
  log "Ошибка: требуется один шаблон; использование: vrg '<шаблон>'."
  exit 1
fi
for dependency in rg fzf bat code; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    log "Ошибка: $dependency не найден в PATH; установите его перед запуском."
    exit 1
  fi
done

# --- Поиск и предпросмотр: rg → список fzf → bat; Enter передаёт файл и строку в code ---
# -- защищает шаблон с начальным дефисом от разбора как параметра rg.
arg=$1
log 'Поиск в текущем каталоге: до двух совпавших строк на файл; Enter — открыть, Esc — выйти.'
rg --vimgrep -m2 -- "$arg" | \
fzf --preview 'bat --style=numbers --color=always --highlight-line {2} {1} --paging=always' \
    --delimiter ':' --nth 1,2,3 \
    --bind "enter:execute(code --goto --new-window {1}:{2} > /dev/tty)"

# --- Итог: различить ошибку поиска, отсутствие совпадений и отмену пользователем ---
# PIPESTATUS сохраняем сразу: любая другая команда перезапишет коды конвейера.
search_status=("${PIPESTATUS[@]}")
if (( search_status[1] == 130 )); then
  log 'Выбор отменён пользователем.'
elif (( search_status[0] > 1 )); then
  log "Ошибка ripgrep, код ${search_status[0]}; причина указана в его выводе выше."
  exit "${search_status[0]}"
elif (( search_status[0] == 1 )); then
  log 'Совпадений не найдено.'
elif (( search_status[1] == 0 )); then
  log 'Интерактивный выбор завершён.'
else
  log "fzf завершился без выбора или с ошибкой, код ${search_status[1]}; подробности выше."
fi
exit "${search_status[1]}"
