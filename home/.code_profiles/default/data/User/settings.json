{
    // === VS Code: интерфейс, окна и вкладки ===
    "workbench.editor.showTabs": "single",
    "workbench.editor.showIcons": false,
    // "workbench.layoutControl.enabled": false,
    "workbench.editor.labelFormat": "medium",
    "window.zoomLevel": 0,
    "window.restoreWindows": "all",
    "window.openFoldersInNewWindow": "on",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook",
        "*.pdf": "latex-workshop-pdf-hook"
    },
    "workbench.startupEditor": "none",
    "window.customTitleBarVisibility": "auto",
    "window.menuBarVisibility": "compact",
    "workbench.activityBar.location": "top",
    "window.commandCenter": true,
    "workbench.sideBar.location": "right",

    // === VS Code: редактор, отображение текста и автодополнение ===
    "editor.renderWhitespace": "all",
    "editor.definitionLinkOpensInPeek": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.fontSize": 14,
    // https://code.visualstudio.com/docs/editing/editingevolved#_breadcrumb-keyboard-navigation
    // Ctrl+Shift+.  select that last element and open a dropdown
    // Ctrl+Shift+;  focus the last element
    "breadcrumbs.enabled": true,
    "editor.rulers": [
        80
    ],
    "editor.renderControlCharacters": true,
    "editor.minimap.size": "fit",
    "editor.snippetSuggestions": "top",
    "editor.tabCompletion": "on",
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "editor.suggestSelection": "first",
    "editor.formatOnSaveMode": "modifications",
    "editor.minimap.enabled": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.wordWrap": "on",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Droid Sans Mono',  'Consolas', 'monospace', monospace",

    // === VS Code: файлы и проводник ===
    "files.trimTrailingWhitespace": false,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.venv/**": true,
        "**/venv/**": true
    },
    "explorer.confirmDelete": false,

    // === VS Code: встроенный терминал ===
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.fontWeightBold": "normal",

    // === VS Code: телеметрия и рекомендации расширений ===
    "telemetry.telemetryLevel": "off",
    "extensions.ignoreRecommendations": true,

    // === Git, SCM и просмотр изменений ===
    // выбор файла в SCM мышью или Enter открывает сам рабочий файл вместо diff Changes
    "git.openDiffOnClick": false,
    "[git-commit]": {
        "editor.rulers": [
            72,
            50
        ],
        "editor.wordWrap": "off"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "scm.alwaysShowRepositories": true,
    "git.autofetch": true,
    "diffEditor.renderSideBySide": false,
    "diffEditor.experimental.showMoves": true,
    "git.confirmSync": false,
    "git.ignoreRebaseWarning": true,
    "git.replaceTagsWhenPull": true,

    // === GitLens ===
    "gitlens.gitCommands.closeOnFocusOut": true,
    "gitlens.graph.minimap.enabled": false,

    // === Git Graph ===
    "git-graph.openNewTabEditorGroup": "Two",

    // === Git Blame ===
    "gitblame.inlineMessageEnabled": true,

    // === Project Manager ===
    "projectManager.tags.collapseItems": "startCollapsed",
    "projectManager.git.baseFolders": [],
    "projectManager.checkInvalidPathsBeforeListing": false,
    "projectManager.git.ignoredFolders": [
        "node_modules",
        "out",
        "typings",
        "test",
        ".haxelib",
        "dotbot"
    ],

    // === Code Spell Checker: проверка орфографии ===
    "cSpell.language": "en,ru",
    "cSpell.userWords": [],

    // === Todo Tree: метки задач в коде ===
    "todo-tree.regex.regex": "(//|%|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",
    "todo-tree.general.statusBar": "total",
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        "[x]",
        "FIXME"
    ],

    // === Rewrap и Trailing Spaces: переносы и пробелы ===
    "rewrap.autoWrap.enabled": false,
    "trailing-spaces.highlightCurrentLine": false,

    // === Python, Pylance и Ruff ===
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
    },
    "python.languageServer": "Pylance",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.analysis.typeCheckingMode": "standard",

    // === Jupyter и notebooks ===
    "notebook.formatOnSave.enabled": true,
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll": "explicit"
    },
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "notebook.lineNumbers": "on",
    "jupyter.askForKernelRestart": false,

    // === Go ===
    "go.formatTool": "goimports",
    "go.toolsManagement.autoUpdate": true,

    // === JSON и JSON with Comments ===
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },

    // === Prettier: форматирование ===
    "prettier.configPath": "prettier.config.cjs",
    "prettier.requireConfig": true,

    // === ESLint: линтинг и форматирование ===
    "eslint.useFlatConfig": true,
    "eslint.format.enable": true,

    // === Nuxtr: шаблоны Vue и Nuxt ===
    "nuxtr.vueFiles.template.defaultLanguage": "html",
    "nuxtr.vueFiles.firstTag": "script",
    "nuxtr.vueFiles.script.type": "setup",
    "nuxtr.vueFiles.script.defaultLanguage": "ts",
    "nuxtr.vueFiles.style.addStyleTag": true,
    "nuxtr.vueFiles.style.alwaysScoped": true,
    "nuxtr.piniaFiles.defaultTemplate": "setup",

    // === Веб-разработка: TypeScript, Vue, HTML, CSS и SCSS ===
    "scss.lint.unknownAtRules": "ignore",
    "[typescriptreact][typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": {
            "editor.action.organizeImports": "always",
            "editor.action.formatDocument": "always",
            "eslint.executeAutofix": "always"
        },
    },
    "[vue]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint",
        // "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": {
            "editor.action.organizeImports": "always",
            "editor.action.formatDocument": "always",
            "eslint.executeAutofix": "always"
        },
        "editor.rulers": [
            80
        ],
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },

    // === Markdown и Marp: документы и презентации ===
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true
    },
    "markdown.marp.pdf.outlines": "headings",
    "markdown.marp.browser": "chrome",

    // === LaTeX ===
    "[latex]": {
        "editor.rulers": [
            100
        ],
        "editor.wrappingIndent": "same",
        // Перенос по словам
        "editor.wordWrap": "on",
        "editor.wordWrapColumn": 100
    },

    // === C и C++: clang-format ===
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },

    // === PlatformIO ===
    "platformio-ide.autoCloseSerialMonitor": true,
    "platformio-ide.forceUploadAndMonitor": true,

    // === ESP-IDF: пути и инструменты ===
    "idf.espIdfPath": "/home/axl/.esp/esp-idf",
    "idf.toolsPath": "/home/axl/.espressif",
    "idf.customExtraPaths": "/home/axl/.espressif/tools/xtensa-esp-elf-gdb/12.1_20221002/xtensa-esp-elf-gdb/bin:/home/axl/.espressif/tools/riscv32-esp-elf-gdb/12.1_20221002/riscv32-esp-elf-gdb/bin:/home/axl/.espressif/tools/xtensa-esp32-elf/esp-12.2.0_20230208/xtensa-esp32-elf/bin:/home/axl/.espressif/tools/xtensa-esp32s2-elf/esp-12.2.0_20230208/xtensa-esp32s2-elf/bin:/home/axl/.espressif/tools/xtensa-esp32s3-elf/esp-12.2.0_20230208/xtensa-esp32s3-elf/bin:/home/axl/.espressif/tools/riscv32-esp-elf/esp-12.2.0_20230208/riscv32-esp-elf/bin:/home/axl/.espressif/tools/esp32ulp-elf/2.35_20220830/esp32ulp-elf/bin:/home/axl/.espressif/tools/openocd-esp32/v0.12.0-esp32-20230419/openocd-esp32/bin:/home/axl/.espressif/tools/esp-rom-elfs/20230320",
    "idf.customExtraVars": {
        "OPENOCD_SCRIPTS": "/home/axl/.espressif/tools/openocd-esp32/v0.12.0-esp32-20230419/openocd-esp32/share/openocd/scripts",
        "ESP_ROM_ELF_DIR": "/home/axl/.espressif/tools/esp-rom-elfs/20230320/"
    },
    "idf.gitPath": "git",

    // === Red Hat: телеметрия ===
    "redhat.telemetry.enabled": false,

    // === YAML, Docker Compose и GitHub Actions ===
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "yaml.customTags": [
        "!reference sequence"
    ],
    "yaml.disableSchemaDetection": [],

    // === Docker ===
    "docker.extension.enableComposeLanguageServer": false,

    // === Makefile Tools ===
    "makefile.configureOnOpen": false,

    // === Remote SSH ===
    "remote.SSH.experimental.chat": false,

    // === Continue ===
    "continue.enableTabAutocomplete": true,
    "continue.telemetryEnabled": false,
    "continue.showInlineTip": false,

    // === Codeium ===
    "codeium.enableConfig": {
        "*": true,
        "ansible": true
    },

    // === SourceCraft Code Assistant ===
    "sourcecraft-code-assist.delayedRequestTimeoutMs": 600,

    // === Kilo Code: разрешённые и запрещённые команды ===
    "kilo-code.allowedCommands": [
        "git log",
        "git diff",
        "git show"
    ],
    "kilo-code.deniedCommands": [],

    // === VSCodeVim и обработка клавиатуры ===
    "keyboard.dispatch": "keyCode",
    "vim.leader": ",",
    "vim.easymotion": true,
    "vim.useSystemClipboard": true,
    "vim.surround": true,
    "vim.handleKeys": {
        "<C-k>": false,
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        // Предыдущий открытый буфер.
        {
            "before": [
                "<S-h>"
            ],
            "commands": [
                ":bprevious"
            ]
        },
        // Следующий открытый буфер.
        {
            "before": [
                "<S-l>"
            ],
            "commands": [
                ":bnext"
            ]
        },
        // Предыдущее совпадение поиска с центрированием.
        {
            "before": [
                "N"
            ],
            "after": [
                "N",
                "z",
                "z"
            ]
        },
        // Следующее совпадение поиска с центрированием.
        {
            "before": [
                "n"
            ],
            "after": [
                "n",
                "z",
                "z"
            ]
        },
        // Вниз по отображаемой строке с учётом переноса.
        {
            "before": [
                "j"
            ],
            "after": [
                "g",
                "j"
            ]
        },
        // Открыть проводник.
        {
            "before": [
                "<leader>",
                "e"
            ],
            "commands": [
                "workbench.view.explorer"
            ]
        },
        // Вверх по отображаемой строке с учётом переноса.
        {
            "before": [
                "k"
            ],
            "after": [
                "g",
                "k"
            ]
        },
        // Закрыть панели и редакторы других групп, свернуть проводник и закрыть Git diff.
        {
            "before": [
                "<leader>",
                "z"
            ],
            "commands": [
                "workbench.action.closePanel",
                "workbench.action.closeSidebar",
                "workbench.action.minimizeOtherEditorsHideSidebar",
                "workbench.files.action.collapseExplorerFolders",
                "workbench.action.closeEditorsInOtherGroups",
                "git.closeAllDiffEditors"
            ]
        },
        // Форматировать документ без сохранения; для Python выбран Ruff. Исправления — через Code Actions.
        {
            "before": [
                "<leader>",
                "d",
                "f"
            ],
            "commands": [
                "editor.action.formatDocument"
            ]
        },
        // Открыть поиск по содержимому с пустым запросом для ввода.
        {
            "before": [
                "<leader>",
                "s"
            ],
            "commands": [
                {
                    "command": "workbench.action.findInFiles",
                    "args": {
                        "query": "",
                        "triggerSearch": false
                    }
                }
            ]
        },
        // Перейти к определению символа.
        {
            "before": [
                "<leader>",
                "g",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        // Найти ссылки и открыть дерево References.
        {
            "before": [
                "<leader>",
                "g",
                "r"
            ],
            "commands": [
                "references-view.findReferences",
                "references-view.tree.focus"
            ]
        },
        // Буквальный поиск слова под курсором или выделения по рабочему пространству.
        {
            "before": [
                "<leader>",
                "g",
                "f"
            ],
            "commands": [
                {
                    "command": "workbench.action.findInFiles",
                    "args": {
                        "isRegex": false
                    }
                }
            ]
        },
        // Показать ссылки на символ.
        {
            "before": [
                "<leader>",
                "g",
                "u"
            ],
            "commands": [
                "editor.action.goToReferences"
            ]
        },
        // Переключить исходник / заголовок (расширение C/C++).
        {
            "before": [
                "<leader>",
                "g",
                "h"
            ],
            "commands": [
                "C_Cpp.SwitchHeaderSource"
            ]
        },
        // Открыть Git Graph с перестройкой групп редакторов.
        {
            "before": [
                "<leader>",
                "t",
                "g",
                "g"
            ],
            "commands": [
                "workbench.action.togglePanel",
                "workbench.view.scm",
                "workbench.action.closeAllGroups",
                "git-graph.view",
                "workbench.action.splitEditorDown"
            ]
        },
        // Открыть SCM и сфокусировать группу ресурсов.
        {
            "before": [
                "<leader>",
                "t",
                "g",
                "v"
            ],
            "commands": [
                "workbench.view.scm",
                "workbench.scm.action.focusNextResourceGroup"
            ]
        },
        // Выбрать открытый редактор во всех группах.
        {
            "before": [
                "<leader>",
                "t",
                "o"
            ],
            "commands": [
                "workbench.action.showAllEditors"
            ]
        },
        // Показать / скрыть боковую панель.
        {
            "before": [
                "<leader>",
                "t",
                "s"
            ],
            "commands": [
                "workbench.action.toggleSidebarVisibility"
            ]
        },
        // Сфокусировать дерево References.
        {
            "before": [
                "<leader>",
                "t",
                "r"
            ],
            "commands": [
                "references-view.tree.focus"
            ]
        },
        // Открыть выбор элемента breadcrumbs.
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "breadcrumbs.focusAndSelect"
            ]
        },
        // Сохранить все изменённые файлы.
        {
            "before": [
                "<leader>",
                "w"
            ],
            "commands": [
                "workbench.action.files.saveAll"
            ]
        },
        // Предыдущая диагностика в текущем файле.
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                "editor.action.marker.prev"
            ]
        },
        // Следующая диагностика в текущем файле.
        {
            "before": [
                "]",
                "d"
            ],
            "commands": [
                "editor.action.marker.next"
            ]
        },
        // Предыдущее изменение обычного или diff-редактора.
        {
            "before": [
                "[",
                "c"
            ],
            "commands": [
                "workbench.action.editor.previousChange",
                "workbench.action.compareEditor.previousChange"
            ]
        },
        // Следующее изменение обычного или diff-редактора.
        {
            "before": [
                "]",
                "c"
            ],
            "commands": [
                "workbench.action.editor.nextChange",
                "workbench.action.compareEditor.nextChange"
            ]
        },
        // EasyMotion: переход по двум введённым символам.
        {
            "before": [
                "s"
            ],
            "after": [
                "leader",
                "leader",
                "2",
                "s"
            ]
        },
        // Найти файл по имени.
        {
            "before": [
                "<leader>",
                "f"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        // Выбрать открытый редактор; аналог ,to.
        {
            "before": [
                "<leader>",
                "b"
            ],
            "commands": [
                "workbench.action.showAllEditors"
            ]
        },
        // Открыть Git status; аналог ,tgv.
        {
            "before": [
                "<leader>",
                "g",
                "s"
            ],
            "commands": [
                "workbench.view.scm"
            ]
        },
        // Показать документацию / тип символа.
        {
            "before": [
                "K"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        // Вниз по отображаемой строке с учётом переноса.
        {
            "before": [
                "j"
            ],
            "after": [
                "g",
                "j"
            ]
        },
        // Вверх по отображаемой строке с учётом переноса.
        {
            "before": [
                "k"
            ],
            "after": [
                "g",
                "k"
            ]
        },
        // Буквальный поиск слова под курсором или выделения по рабочему пространству.
        {
            "before": [
                "<leader>",
                "g",
                "f"
            ],
            "commands": [
                {
                    "command": "workbench.action.findInFiles",
                    "args": {
                        "isRegex": false
                    }
                }
            ]
        }
    ],
    "projectManager.sortList": "Path",
}
